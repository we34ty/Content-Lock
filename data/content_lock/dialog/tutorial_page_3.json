    {
      "type": "minecraft:plain_message",
      "contents": {
        "translate": "content_lock:dialogue.tutorial.page3.text2",
        "fallback": "Upgrading Tools: \n\n To upgrade your tools, you'll need to use a smithing table along with the appropriate upgrade item as well as matching Upgrade Template and material. Simply place your tool along with mentioned items in the smithing table to apply the upgrade. Each upgrade doesn't change much, besides allowing for different enchants to be applied to given tool and changing both attack speed and damage as well as durability. Be sure to experiment with different upgrades to find the perfect combination for your playstyle."
      },
      "width": 400
    },
    {
      "type": "minecraft:item",
      "item": {
        "id": "smithing_table"
      },
      "description": {
        "translate": "content_lock:dialogue.tutorial.page3.smithing_table_description",
        "fallback": "Smithing Table is used to upgrade your tools using Upgrade Templates and appropriate materials. It can be crafted using 4 wooden planks and 2 iron ingots.",
        "color": "gray"
      }
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "translate": "content_lock:dialogue.tutorial.page3.text3",
        "fallback": "Upgrade Templates: \n\n Upgrade Templates are special items that allow your tools to be upgraded to another type in the path of your choosing. Each template corresponds to a specific upgrade path and material type. The upgrade paths go like this: \n - Wood->Copper/Stone/Chainmail, \n - Copper->Gold->Diamond, \n - Stone/Chainmail->Iron->Netherite. \n Each path has it's own quirks so make sure to use the correct template when upgrading your tools to ensure compatibility and unlock the desired benefits."
      },
      "width": 400
    },
    {
      "type": "minecraft:item",
      "item": {
        "id": "wild_armor_trim_smithing_template"
      },
      "description": {
        "translate": "content_lock:dialogue.tutorial.page3.stone_upgrade_description",
        "fallback": "Chainmail, Stone and Copper Upgrades can be obtained by blowing up stone.",
        "color": "gray"
      },
      "show_tooltip": false,
      "show_decorations": false
    },
    {
      "type": "minecraft:item",
      "item": {
        "id": "snout_armor_trim_smithing_template"
      },
      "description": {
        "translate": "content_lock:dialogue.tutorial.page3.iron_upgrade_description",
        "fallback": "Iron and Golden Upgrades can be crafted with the lower tier of Upgrade as well as by killing Zombified Piglins in overworld.",
        "color": "gray"
      },
      "show_tooltip": false,
      "show_decorations": false
    },
    {
      "type": "minecraft:item",
      "item": {
        "id": "netherite_upgrade_smithing_template"
      },
      "description": {
        "translate": "content_lock:dialogue.tutorial.page3.netherite_upgrade_description",
        "fallback": "Diamond and Netherite Upgrades can be found inside of Bastions in the Nether, as well as crafted using the lower tier of Upgrade.",
        "color": "gray"
      },
      "show_tooltip": false,
